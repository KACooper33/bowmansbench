---
/**
 * About, contact, and disclosure.
 *
 * These pages carry no affiliate links and no comparison table, so they take
 * the plainest layout. They still carry the email signup, from BaseLayout.
 */
import type { CollectionEntry } from 'astro:content';
import BaseLayout from './BaseLayout.astro';
import Sources from '../components/Sources.astro';

interface Props {
  page: CollectionEntry<'pages'>;
}

const { page } = Astro.props;
const { title, description, updated_on, sources } = page.data;
---

<BaseLayout title={title} description={description} updatedOn={updated_on}>
  <article class="page page--trust">
    <h1>{title}</h1>
    <p class="page__description">{description}</p>

    <div class="page__body">
      <slot />
    </div>

    <Sources sources={sources} />
  </article>
</BaseLayout>
