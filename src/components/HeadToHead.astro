---
/**
 * A direct pairing inside a comparison page. PROJECT_PLAN.md section 4, part 6.
 *
 * Use it from an MDX page body:
 *
 *   import HeadToHead from '../../components/HeadToHead.astro';
 *
 *   <HeadToHead a="beiter-plunger" b="shibuya-dx-plunger">
 *     One paragraph on which one wins, and for whom.
 *   </HeadToHead>
 *
 * Both product names print in full, every time, so the section stands alone.
 */
import { getEntry } from 'astro:content';

interface Props {
  a: string;
  b: string;
}

const { a, b } = Astro.props;

const first = await getEntry('products', a);
const second = await getEntry('products', b);

if (!first) throw new Error(`HeadToHead: no product record with id "${a}".`);
if (!second) throw new Error(`HeadToHead: no product record with id "${b}".`);
---

<section class="head-to-head">
  <h2>{first.data.name} vs {second.data.name}</h2>
  <slot />
</section>
